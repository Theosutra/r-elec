---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { company, serviceArea } from '../data/company';
import { needOptions } from '../data/services';
import { breadcrumbJsonLd } from '../lib/seo';

const crumbs = [{ label: 'Contact et devis', href: '/contact' }];
const endpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || 'https://formspree.io/f/TODO_CLIENT';
const a = company.address;
const { latitude: lat, longitude: lon } = company.geo;
const osmEmbed = `https://www.openstreetmap.org/export/embed.html?bbox=${lon - 0.012}%2C${lat - 0.006}%2C${lon + 0.012}%2C${lat + 0.006}&layer=mapnik&marker=${lat}%2C${lon}`;
const osmLink = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=16/${lat}/${lon}`;
const mapsQuery = encodeURIComponent(`${a.street}, ${a.postalCode} ${a.city}`);

const field =
  'mt-1.5 block w-full rounded-xl border border-line bg-white px-3.5 text-[0.975rem] text-ink placeholder:text-ink-muted outline-none transition-[border-color,box-shadow] hover:border-[#c9d2e3] focus:border-brand focus:shadow-[0_0_0_3px_rgb(32_77_156/0.18)] user-invalid:border-[#c2410c]';
const label = 'block text-sm font-semibold text-ink';
---

<BaseLayout
  title="Contact et devis gratuit, électricien Vendargues | R-ELEC"
  description="Devis gratuit pour vos travaux d’électricité, de climatisation ou de pompe à chaleur à Vendargues et alentours. Appelez le 06 19 91 61 19 ou écrivez-nous."
  jsonLd={[breadcrumbJsonLd(crumbs, Astro.site)]}
>
  <PageHero
    title="Contact et devis gratuit :"
    highlight="parlons de votre projet."
    lead="Le plus rapide reste de nous appeler. Vous préférez écrire ? Décrivez votre besoin ci-dessous, joignez une photo si vous le pouvez, et nous vous rappelons pour fixer un rendez-vous."
    crumbs={crumbs}
    hideQuote
  />

  <section class="container-site pt-12 lg:pt-16" aria-label="Formulaire et coordonnées">
    <div class="grid gap-6 lg:grid-cols-[1.45fr_1fr] lg:gap-8">
      <form
        id="devis"
        action={endpoint}
        method="POST"
        enctype="multipart/form-data"
        class="scroll-mt-28 rounded-[var(--radius-panel)] border border-line p-6 sm:p-8 lg:p-10"
        data-quote-form
        data-phone={company.phones.main.display}
      >
        <h2 class="text-[1.75rem] sm:text-[2rem]">Demande de devis gratuit</h2>
        <p class="mt-2 text-ink-muted">Les champs marqués d’un astérisque sont obligatoires.</p>

        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          <div>
            <label for="c-nom" class={label}>Nom <span aria-hidden="true">*</span></label>
            <input id="c-nom" name="nom" type="text" autocomplete="name" required class:list={[field, 'h-12']} placeholder="Votre nom" />
          </div>
          <div>
            <label for="c-tel" class={label}>Téléphone <span aria-hidden="true">*</span></label>
            <input id="c-tel" name="telephone" type="tel" inputmode="tel" autocomplete="tel" required pattern="[0-9 +.()-]{10,}" class:list={[field, 'h-12']} placeholder="06 12 34 56 78" />
          </div>
          <div>
            <label for="c-email" class={label}>E-mail</label>
            <input id="c-email" name="email" type="email" autocomplete="email" class:list={[field, 'h-12']} placeholder="vous@exemple.fr" />
          </div>
          <div>
            <label for="c-ville" class={label}>Ville <span aria-hidden="true">*</span></label>
            <input id="c-ville" name="ville" type="text" autocomplete="address-level2" required list="c-villes" class:list={[field, 'h-12']} placeholder="Vendargues, Castries…" />
            <datalist id="c-villes">
              {serviceArea.map((c) => <option value={c.name} />)}
            </datalist>
          </div>
          <div class="sm:col-span-2">
            <label for="c-besoin" class={label}>Type de besoin <span aria-hidden="true">*</span></label>
            <div class="relative">
              <select id="c-besoin" name="besoin" required class:list={[field, 'h-12 appearance-none pr-10']}>
                <option value="" disabled selected>Choisir…</option>
                {needOptions.map((o) => <option>{o}</option>)}
              </select>
              <Icon name="chevron-down" size={18} class="pointer-events-none absolute top-1/2 right-3.5 -translate-y-[calc(50%-3px)] text-ink-muted" />
            </div>
          </div>
          <div class="sm:col-span-2">
            <label for="c-message" class={label}>Votre message <span aria-hidden="true">*</span></label>
            <textarea id="c-message" name="message" rows="5" required class:list={[field, 'py-3 leading-relaxed']} placeholder="Décrivez la panne ou le projet : type de logement, pièces concernées, délai souhaité…"></textarea>
          </div>
          <div class="sm:col-span-2">
            <label for="c-photo" class={label}>Photo (facultatif)</label>
            <p id="c-photo-aide" class="mt-1 text-sm text-ink-muted">Une photo du tableau, de l’appareil ou de la pièce nous aide à préparer le devis. 8 Mo maximum.</p>
            <div class="file-field mt-3 flex items-center gap-4 rounded-xl border border-dashed border-[#c9d2e3] bg-panel p-3 transition-colors hover:border-brand">
              <input id="c-photo" name="photo" type="file" accept="image/*" aria-describedby="c-photo-aide c-photo-nom" class="peer sr-only" data-file-input />
              <label for="c-photo" class="inline-flex h-10 shrink-0 cursor-pointer items-center gap-2 rounded-full bg-navy-900 px-4 text-sm font-semibold text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-3 peer-focus-visible:outline-brand">
                Choisir une photo
              </label>
              <span id="c-photo-nom" class="min-w-0 truncate text-sm text-ink-muted" data-file-name>Aucune photo</span>
            </div>
          </div>
        </div>

        <div class="hidden" aria-hidden="true">
          <label for="c-gotcha">Ne pas remplir</label>
          <input id="c-gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="_subject" value="Demande de devis (site R-ELEC, page contact)" />

        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <p class="max-w-sm text-sm text-ink-muted">
            Vos données servent uniquement à répondre à votre demande. <a href="/politique-confidentialite" class="underline">Politique de confidentialité</a>
          </p>
          <button
            type="submit"
            class="inline-flex h-13 shrink-0 items-center justify-center gap-2 rounded-full bg-volt px-7 font-semibold text-navy-950 transition-colors hover:bg-volt-600 disabled:cursor-wait disabled:opacity-70"
          >
            Envoyer ma demande
            <Icon name="send" size={18} class="send-icon" />
            <Icon name="loader-circle" size={18} class="spin-icon hidden animate-spin" />
          </button>
        </div>
        <p data-status role="status" aria-live="polite" tabindex="-1" class="hidden"></p>
      </form>

      <aside class="grid content-start gap-6">
        <div class="on-dark rounded-[var(--radius-panel)] bg-navy-900 p-6 text-white sm:p-8">
          <h2 class="text-2xl">Nous joindre</h2>
          <a href={company.phones.main.href} class="mt-6 flex items-center gap-4 rounded-2xl bg-volt p-4 text-navy-950">
            <span class="grid size-12 place-items-center rounded-full bg-navy-900 text-volt"><Icon name="phone" size={22} /></span>
            <span>
              <span class="block text-sm font-semibold">Ligne principale, 24h/24</span>
              <span class="block font-mono text-[1.25rem] leading-tight font-medium tracking-[-0.04em] whitespace-nowrap tabular sm:text-[1.5rem]">{company.phones.main.display}</span>
            </span>
          </a>
          <ul class="mt-6 grid gap-4 text-on-dark">
            <li class="flex items-center gap-3">
              <Icon name="phone" size={18} class="text-on-dark-muted" />
              <a href={company.phones.secondary.href} class="tabular hover:underline">{company.phones.secondary.display}</a>
            </li>
            <li class="flex items-center gap-3">
              <Icon name="mail" size={18} class="text-on-dark-muted" />
              <a href={`mailto:${company.email}`} class="hover:underline">{company.email}</a>
            </li>
            <li class="flex items-start gap-3">
              <Icon name="map-pin" size={18} class="mt-1 shrink-0 text-on-dark-muted" />
              <address class="not-italic">{a.street}<br />{a.postalCode} {a.city}</address>
            </li>
            <li class="flex items-start gap-3">
              <Icon name="clock" size={18} class="mt-1 shrink-0 text-on-dark-muted" />
              <span>
                Dépannage&nbsp;: {company.openingHours.emergency}<br />
                <span class="text-on-dark-muted">
                  Devis&nbsp;: {company.openingHours.office || 'nous vous rappelons rapidement'}
                </span>
              </span>
            </li>
          </ul>
        </div>

        <div class="overflow-hidden rounded-[var(--radius-panel)] border border-line">
          <div class="relative aspect-[4/3] bg-panel" data-map data-src={osmEmbed}>
            <div class="absolute inset-0 grid place-items-center p-6 text-center">
              <div>
                <Icon name="map-pin" size={28} class="mx-auto text-brand" />
                <p class="mt-3 font-semibold">{a.city}, {a.postalCode}</p>
                <p class="mt-1 text-sm text-ink-muted">La carte est chargée depuis OpenStreetMap seulement si vous la demandez.</p>
                <button type="button" data-map-load class="mt-4 inline-flex h-11 items-center rounded-full bg-navy-900 px-5 text-sm font-semibold text-white hover:bg-navy-800">
                  Afficher la carte
                </button>
              </div>
            </div>
          </div>
          <div class="flex flex-wrap gap-x-5 gap-y-2 border-t border-line px-5 py-4 text-sm font-semibold">
            <a href={osmLink} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-brand hover:underline">OpenStreetMap <Icon name="arrow-up-right" size={15} /></a>
            <a href={`https://www.google.com/maps/search/?api=1&query=${mapsQuery}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-brand hover:underline">Google Maps <Icon name="arrow-up-right" size={15} /></a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/quote-form';

  document.querySelectorAll<HTMLInputElement>('[data-file-input]').forEach((input) => {
    const label = input.closest('.file-field')?.querySelector<HTMLElement>('[data-file-name]');
    const update = () => {
      if (label) label.textContent = input.files?.[0]?.name ?? 'Aucune photo';
    };
    input.addEventListener('change', update);
    input.form?.addEventListener('reset', () => setTimeout(update));
  });

  document.querySelectorAll<HTMLElement>('[data-map]').forEach((box) => {
    box.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = box.dataset.src ?? '';
      iframe.title = 'Carte : R-ELEC à Vendargues';
      iframe.loading = 'lazy';
      iframe.className = 'absolute inset-0 size-full border-0';
      box.replaceChildren(iframe);
    });
  });
</script>
