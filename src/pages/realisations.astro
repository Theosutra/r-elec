---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { realisations, placeholderSlots, categoryLabels, type RealisationCategory } from '../data/realisations';
import { breadcrumbJsonLd } from '../lib/seo';
import vansPhoto from '../assets/photos/realisations/hero-equipe.jpeg';

const crumbs = [{ label: 'Réalisations', href: '/realisations' }];

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/realisations/**/*.{jpg,jpeg,png,webp,JPG,JPEG}', {
  eager: true,
});
const photo = (path: string) => {
  const found = files[`../assets/photos/realisations/${path}`];
  if (!found) throw new Error(`Photo introuvable : src/assets/photos/realisations/${path}`);
  return found.default;
};

const items = realisations.map((r) => ({ ...r, images: r.photos.map(photo) }));
// Les emplacements « Photo à venir » ne s'affichent qu'en développement, pour montrer au client où vont ses photos.
const slots = import.meta.env.DEV ? placeholderSlots.slice(0, Math.max(0, 6 - items.length)) : [];
const isEmpty = items.length === 0;
const categories = Object.entries(categoryLabels) as [RealisationCategory, string][];
const formatDate = (d?: string) =>
  d ? new Date(`${d}-01`).toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' }) : '';
---

<BaseLayout
  title="Réalisations : chantiers d’électricité et de climatisation | R-ELEC"
  description="Découvrez les chantiers de R-ELEC dans l’est montpelliérain : tableaux électriques, rénovations, climatisations, pompes à chaleur et dépannages."
  jsonLd={[breadcrumbJsonLd(crumbs, Astro.site)]}
  noindex={isEmpty}
>
  <PageHero
    title="Nos chantiers,"
    highlight={isEmpty ? 'bientôt en images.' : 'en images.'}
    lead={isEmpty
      ? 'Nous rassemblons les photos de nos derniers chantiers. En attendant, appelez-nous : nous vous montrerons volontiers des installations proches de votre projet.'
      : 'Tableaux, rénovations, climatisations, pompes à chaleur : un aperçu du travail de l’équipe dans l’est montpelliérain.'}
    crumbs={crumbs}
    photo={vansPhoto}
    photoAlt="Les deux utilitaires R-ELEC, floqués au nom de l’entreprise"
    photoPosition="25% 60%"
  />

  {(!isEmpty || import.meta.env.DEV) && <section class="container-site pt-16 lg:pt-24" aria-labelledby="galerie-titre">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <h2 id="galerie-titre" class="text-[2rem] sm:text-[2.5rem] lg:text-[2.75rem]">
        <span class="text-ink-soft">Électricité, clim,</span>{' '}<span class="text-brand">dépannage.</span>
      </h2>
      {!isEmpty && <fieldset class="gallery-filters flex flex-wrap gap-2">
        <legend class="sr-only">Filtrer les réalisations</legend>
        <label class="filter-chip"><input type="radio" name="filtre" value="tout" checked class="sr-only" />Tout</label>
        {categories.map(([key, label]) => (
          <label class="filter-chip"><input type="radio" name="filtre" value={key} class="sr-only" />{label}</label>
        ))}
      </fieldset>}
    </div>

    <ul class="gallery mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((r) => (
        <li data-cat={r.category} class="group overflow-hidden rounded-[var(--radius-card)] border border-line bg-white">
          <div class="relative aspect-[4/3] overflow-hidden bg-panel">
            <Picture
              src={r.images[0]}
              alt={`${r.title}${r.city ? ` à ${r.city}` : ''}`}
              formats={['avif', 'webp']}
              widths={[400, 640, 900]}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              class="size-full object-cover transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.03]"
            />
            <span class="absolute top-3 left-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-ink">{categoryLabels[r.category]}</span>
            {r.images.length > 1 && (
              <span class="absolute right-3 bottom-3 rounded-full bg-navy-950/75 px-3 py-1 text-xs font-semibold text-white">{r.images.length} photos</span>
            )}
          </div>
          <div class="p-6">
            <h3 class="text-xl">{r.title}</h3>
            {r.description && <p class="mt-2 text-[0.975rem] text-ink-muted">{r.description}</p>}
            {(r.city || r.date) && (
              <p class="mt-4 flex items-center gap-2 text-sm text-ink-muted">
                <Icon name="map-pin" size={16} />{[r.city, formatDate(r.date)].filter(Boolean).join(' · ')}
              </p>
            )}
          </div>
        </li>
      ))}
      {slots.map((s) => (
        <li data-cat={s.category} class="rounded-[var(--radius-card)] border border-dashed border-[#c9d2e3] bg-panel">
          <div class="grid aspect-[4/3] place-items-center">
            <span class="grid size-14 place-items-center rounded-full bg-white text-brand">
              <Icon name={s.icon} size={26} />
            </span>
          </div>
          <div class="px-6 pb-6">
            <h3 class="text-xl">{s.title}</h3>
            <p class="mt-2 text-sm text-ink-muted">{categoryLabels[s.category]} · photo à venir</p>
          </div>
        </li>
      ))}
    </ul>

    {import.meta.env.DEV && isEmpty && (
      <p class="mt-8 max-w-2xl rounded-xl bg-brand-50 p-4 text-sm text-ink">
        Visible en développement seulement : ajoutez les chantiers dans <code>src/data/realisations.ts</code>. En ligne, cette
        section reste masquée tant qu’aucun chantier n’est saisi.
      </p>
    )}
  </section>}

  <div class="pt-20 lg:pt-28">
    <CtaBand title={isEmpty ? "Un projet ? Parlons-en." : "Un projet semblable ? Parlons-en."} />
  </div>
</BaseLayout>

<style>
  .filter-chip {
    display: inline-flex;
    align-items: center;
    height: 2.75rem;
    padding-inline: 1.125rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .filter-chip:hover {
    border-color: var(--color-brand);
  }
  .filter-chip:has(:checked) {
    background: var(--color-navy-900);
    border-color: var(--color-navy-900);
    color: #fff;
  }
  .filter-chip:has(:focus-visible) {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }
  /* Filtrage sans JavaScript : la case cochée masque les autres catégories. */
  section:has(input[value='electricite']:checked) .gallery li:not([data-cat='electricite']),
  section:has(input[value='climatisation']:checked) .gallery li:not([data-cat='climatisation']),
  section:has(input[value='depannage']:checked) .gallery li:not([data-cat='depannage']) {
    display: none;
  }
</style>
