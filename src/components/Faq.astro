---
import Icon from './Icon.astro';
import type { FaqItem } from '../data/faq';
import { fr } from '../lib/typo';

interface Props {
  items: FaqItem[];
  name?: string;
}

const { items, name = 'faq' } = Astro.props;
---

<div class="divide-y divide-line border-y border-line">
  {items.map((item, i) => (
    <details name={name} class="group faq-item" open={i === 0}>
      <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-left text-lg font-semibold tracking-[-0.015em] [&::-webkit-details-marker]:hidden">
        {fr(item.question)}
        <span class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-full bg-panel text-ink transition-[transform,background-color] duration-300 group-open:rotate-180 group-open:bg-volt">
          <Icon name="chevron-down" size={18} />
        </span>
      </summary>
      <div class="faq-body">
        <p class="max-w-[38rem] pb-6 text-ink-muted">{fr(item.answer)}</p>
      </div>
    </details>
  ))}
</div>

<style>
  .faq-item::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.4s var(--ease-out-expo),
      content-visibility 0.4s allow-discrete;
  }
  .faq-item[open]::details-content {
    block-size: auto;
  }
  @supports not (interpolate-size: allow-keywords) {
    .faq-item::details-content {
      block-size: auto;
    }
  }
  :global(html) {
    interpolate-size: allow-keywords;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-item::details-content {
      transition: none;
    }
  }
</style>
