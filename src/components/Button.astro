---
import Icon from './Icon.astro';

type Variant = 'volt' | 'navy' | 'outline' | 'outline-dark' | 'white';

interface Props {
  href: string;
  variant?: Variant;
  size?: 'md' | 'lg';
  icon?: string;
  iconEnd?: string;
  class?: string;
  [key: string]: unknown;
}

const { href, variant = 'volt', size = 'md', icon, iconEnd, class: className, ...rest } = Astro.props;

const variants: Record<Variant, string> = {
  volt: 'bg-volt text-navy-950 hover:bg-volt-600 shadow-[0_1px_0_rgb(255_255_255/0.5)_inset,0_10px_24px_-12px_rgb(240_196_25/0.9)]',
  navy: 'bg-navy-900 text-white hover:bg-navy-800',
  outline: 'border border-ink/80 text-ink hover:bg-ink hover:text-white',
  'outline-dark': 'border border-white/35 text-white bg-white/10 hover:bg-white/20',
  white: 'bg-white text-ink hover:bg-brand-50',
};
const sizes = {
  md: 'h-12 px-5 text-[0.95rem] gap-2',
  lg: 'h-14 px-7 text-base gap-2.5',
};
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center justify-center rounded-full font-semibold whitespace-nowrap transition-[background-color,color,box-shadow,transform] duration-200 ease-out active:translate-y-px',
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  {icon && <Icon name={icon} size={size === 'lg' ? 20 : 18} />}
  <slot />
  {iconEnd && (
    <Icon
      name={iconEnd}
      size={18}
      class="transition-transform duration-300 ease-[var(--ease-out-expo)] group-hover:translate-x-0.5"
    />
  )}
</a>
