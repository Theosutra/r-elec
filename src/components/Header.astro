---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { company } from '../data/company';
import { mainNav } from '../data/navigation';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href;
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-white/95 backdrop-blur-[6px]">
  <div class="container-site flex h-[4.5rem] items-center justify-between gap-6 lg:h-20">
    <a href="/" class="shrink-0 rounded-lg" aria-label="R-ELEC, retour à l'accueil">
      <Logo />
    </a>

    <nav aria-label="Navigation principale" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {mainNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="rounded-full px-3.5 py-2 text-[0.95rem] font-medium text-ink transition-colors hover:bg-panel aria-[current=page]:bg-brand-50 aria-[current=page]:text-brand"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-2.5 lg:flex">
      <Button href={company.phones.main.href} variant="outline" icon="phone" class="tabular">
        {company.phones.main.display}
      </Button>
      <Button href="/contact#devis" variant="volt">Devis gratuit</Button>
    </div>

    <button
      type="button"
      popovertarget="mobile-menu"
      class="inline-flex h-11 items-center gap-2 rounded-full border border-line px-4 text-sm font-semibold lg:hidden"
      aria-haspopup="dialog"
    >
      <span class="flex w-4 flex-col gap-[3px]" aria-hidden="true">
        <span class="h-[2px] rounded bg-ink"></span>
        <span class="h-[2px] rounded bg-ink"></span>
        <span class="h-[2px] w-2.5 rounded bg-ink"></span>
      </span>
      Menu
    </button>
  </div>

  <div
    id="mobile-menu"
    popover
    class="mobile-menu m-0 ml-auto h-dvh w-[min(22rem,88vw)] max-h-none border-0 bg-white p-0 text-ink shadow-[var(--shadow-float)]"
  >
    <div class="flex h-full flex-col">
      <div class="flex h-[4.5rem] items-center justify-between border-b border-line px-5">
        <span class="text-sm font-semibold text-ink-muted">Menu</span>
        <button
          type="button"
          popovertarget="mobile-menu"
          popovertargetaction="hide"
          class="inline-flex h-11 items-center rounded-full border border-line px-4 text-sm font-semibold"
        >
          Fermer
        </button>
      </div>
      <nav aria-label="Navigation mobile" class="flex-1 overflow-y-auto px-3 py-4">
        <ul class="flex flex-col">
          <li>
            <a href="/" class="block rounded-xl px-3 py-3.5 text-lg font-medium hover:bg-panel">Accueil</a>
          </li>
          {mainNav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="block rounded-xl px-3 py-3.5 text-lg font-medium hover:bg-panel aria-[current=page]:text-brand"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="grid gap-2.5 border-t border-line p-5">
        <Button href={company.phones.main.href} variant="volt" size="lg" icon="phone" class="tabular">
          {company.phones.main.display}
        </Button>
        <Button href="/contact#devis" variant="navy" size="lg">Demander un devis</Button>
        <p class="mt-1 flex items-center justify-center gap-2 text-sm text-ink-muted">
          <span class="live-dot"></span>
          {company.emergency.label}
        </p>
      </div>
    </div>
  </div>
</header>

<style>
  .mobile-menu::backdrop {
    background: rgb(7 15 34 / 0.45);
  }
  .mobile-menu {
    transition:
      translate 0.35s var(--ease-out-expo),
      overlay 0.35s allow-discrete,
      display 0.35s allow-discrete;
    translate: 100% 0;
  }
  .mobile-menu:popover-open {
    translate: 0 0;
  }
  @starting-style {
    .mobile-menu:popover-open {
      translate: 100% 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu {
      transition: none;
    }
  }
</style>
