---
import Icon from './Icon.astro';
import type { ServiceHighlight } from '../data/services';

interface Props {
  service: ServiceHighlight;
}

const { service } = Astro.props;
const dark = service.featured;
---

<a
  href={service.href}
  class:list={[
    'group relative flex flex-col items-center text-center rounded-[var(--radius-card)] p-7 transition-[transform,box-shadow,background-color] duration-300 ease-[var(--ease-out-expo)] hover:-translate-y-0.5 sm:p-8',
    dark
      ? 'on-dark bg-navy-900 text-white hover:shadow-[var(--shadow-float)]'
      : 'bg-white text-ink hover:shadow-[var(--shadow-card)]',
  ]}
>
  <span class="grid size-12 place-items-center rounded-full bg-volt text-navy-950">
    <Icon name={service.icon} size={22} />
  </span>
  <h3 class="mt-6 text-xl">{service.title}</h3>
  <p class:list={['mt-2.5 max-w-[34ch] text-[0.975rem] leading-relaxed', dark ? 'text-on-dark-muted' : 'text-ink-muted']}>
    {service.text}
  </p>
  <span
    class:list={[
      'mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-semibold',
      dark ? 'text-volt' : 'text-brand',
    ]}
  >
    En savoir plus
    <Icon name="arrow-right" size={16} class="transition-transform duration-300 group-hover:translate-x-1" />
  </span>
</a>
