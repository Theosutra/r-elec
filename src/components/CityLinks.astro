---
// Maillage interne services ↔ villes : liens vers les pages locales.
import Icon from './Icon.astro';
import { cities } from '../data/cities';

interface Props {
  title?: string;
  /** Slug à exclure (page courante). */
  exclude?: string;
}

const { title = 'Nous intervenons près de chez vous', exclude } = Astro.props;
const list = cities.filter((c) => c.slug !== exclude);
---

<section class="container-site pt-20 lg:pt-28" aria-labelledby="villes-titre">
  <div class="grid gap-8 lg:grid-cols-[1fr_1.6fr] lg:items-end lg:gap-16">
    <h2 id="villes-titre" class="reveal text-[2rem] sm:text-[2.5rem] lg:text-[2.75rem]">{title}</h2>
    <p class="reveal max-w-xl text-lg text-ink-muted">
      Basés à Vendargues, nous intervenons dans tout l’est montpelliérain : Le Crès, Baillargues, Saint-Aunès, Teyran et les
      communes ci-dessous.
    </p>
  </div>
  <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {list.map((c) => (
      <li>
        <a
          href={`/${c.slug}`}
          class="group flex items-center justify-between gap-4 rounded-[var(--radius-card)] border border-line px-6 py-5 transition-[border-color,background-color] duration-300 hover:border-brand hover:bg-brand-50"
        >
          <span>
            <span class="block text-sm text-ink-muted">{c.kind === 'climatisation' ? 'Climatisation' : 'Électricien'}</span>
            <span class="block text-xl font-semibold tracking-[-0.02em]">{c.city}</span>
          </span>
          <span class="grid size-10 shrink-0 place-items-center rounded-full bg-panel text-ink transition-colors group-hover:bg-volt">
            <Icon name="arrow-right" size={18} />
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
