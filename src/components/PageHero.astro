---
// Bandeau d'en-tête des pages intérieures : carte bleu nuit arrondie, fil d'Ariane,
// H1 (la partie `highlight` passe en jaune), chapô, CTA, et photo optionnelle à droite.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
import { company } from '../data/company';
import type { Crumb } from '../lib/seo';
import { fr } from '../lib/typo';

interface Props {
  title: string;
  highlight?: string;
  lead: string;
  crumbs: Crumb[];
  photo?: ImageMetadata;
  photoAlt?: string;
  photoPosition?: string;
  /** Masque le bouton devis (ex. page contact). */
  hideQuote?: boolean;
}

const { title, highlight, lead, crumbs, photo, photoAlt = '', photoPosition = 'center', hideQuote = false } = Astro.props;
const phone = company.phones.main;
---

<section class="container-site pt-2 sm:pt-3" aria-labelledby="titre-page">
  <div
    class:list={[
      'on-dark relative isolate overflow-hidden rounded-[var(--radius-panel)] bg-navy-900 text-white',
      photo && 'lg:grid lg:grid-cols-[1.35fr_1fr]',
    ]}
  >
    <div class="relative z-10 px-6 pt-8 pb-10 sm:px-10 sm:pt-10 sm:pb-12 lg:px-14 lg:pt-12 lg:pb-16">
      <nav aria-label="Fil d'Ariane">
        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-on-dark-muted">
          <li><a href="/" class="hover:text-white">Accueil</a></li>
          {crumbs.map((c, i) => (
            <li class="flex items-center gap-1.5">
              <span aria-hidden="true">/</span>
              {i === crumbs.length - 1 ? (
                <span aria-current="page" class="text-white">{c.label}</span>
              ) : (
                <a href={c.href} class="hover:text-white">{c.label}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>
      <h1 id="titre-page" class="mt-8 max-w-[18ch] text-[2.4rem] leading-[1.03] sm:text-[3.25rem] lg:mt-14 lg:text-[3.75rem]">
        {fr(title)}{highlight && <> <span class="text-volt">{fr(highlight)}</span></>}
      </h1>
      <p class="mt-5 max-w-[38rem] text-lg leading-relaxed text-on-dark">{fr(lead)}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={phone.href} variant="volt" size="lg" icon="phone" class="tabular">Appeler le {phone.display}</Button>
        {!hideQuote && (
          <Button href="/contact#devis" variant="outline-dark" size="lg" iconEnd="arrow-right">Demander un devis</Button>
        )}
      </div>
      <p class="mt-5 flex items-center gap-2.5 text-sm font-medium text-on-dark">
        <span class="live-dot"></span>
        Dépannage {company.emergency.short}, nuits et week-ends compris
      </p>
    </div>

    {photo && (
      <div class="relative h-64 sm:h-80 lg:h-auto">
        <Picture
          src={photo}
          alt={photoAlt}
          formats={['avif', 'webp']}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1024px) 45vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 size-full object-cover"
          style={`object-position: ${photoPosition}`}
          pictureAttributes={{ class: 'contents' }}
        />
        <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(11_22_48/1)_0%,rgb(11_22_48/0)_35%)] lg:bg-[linear-gradient(90deg,rgb(11_22_48/1)_0%,rgb(11_22_48/0)_40%)]"></div>
      </div>
    )}
  </div>
</section>
