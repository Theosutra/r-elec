---
import { Image } from 'astro:assets';
import icon from '../assets/logo/icon.png';
import wordmark from '../assets/logo/wordmark.png';
import wordmarkWhite from '../assets/logo/wordmark-white.png';

interface Props {
  /** `light` pour fond blanc (header), `dark` pour fond bleu nuit (footer). */
  tone?: 'light' | 'dark';
  class?: string;
}

const { tone = 'light', class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <span
    class:list={[
      'grid size-10 place-items-center rounded-xl',
      tone === 'dark' ? 'bg-white' : 'bg-brand-50',
    ]}
  >
    <Image src={icon} alt="" width={22} height={30} class="h-[30px] w-auto" loading="eager" densities={[1, 2, 3]} />
  </span>
  <Image
    src={tone === 'dark' ? wordmarkWhite : wordmark}
    alt="R-ELEC"
    width={87}
    height={26}
    class="h-[26px] w-auto"
    loading="eager"
    densities={[1, 2, 3]}
  />
</span>
