---
import BaseLayout from './BaseLayout.astro';
import { breadcrumbJsonLd } from '../lib/seo';

interface Props {
  title: string;
  metaTitle: string;
  description: string;
  path: string;
  updated: string;
}

const { title, metaTitle, description, path, updated } = Astro.props;
const crumbs = [{ label: title, href: path }];
---

<BaseLayout title={metaTitle} description={description} jsonLd={[breadcrumbJsonLd(crumbs, Astro.site)]}>
  <div class="container-site pt-10 sm:pt-14 lg:pt-16">
    <nav aria-label="Fil d'Ariane">
      <ol class="flex items-center gap-1.5 text-sm text-ink-muted">
        <li><a href="/" class="hover:text-ink">Accueil</a></li>
        <li class="flex items-center gap-1.5"><span aria-hidden="true">/</span><span aria-current="page" class="text-ink">{title}</span></li>
      </ol>
    </nav>
    <h1 class="mt-6 text-[2.4rem] sm:text-5xl">{title}</h1>
    <p class="mt-3 text-ink-muted">Dernière mise à jour : {updated}</p>
    <div class="legal-prose mt-10 max-w-[40rem] border-t border-line pt-10">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .legal-prose :global(h2) {
    margin-top: 2.75rem;
    font-size: 1.5rem;
  }
  .legal-prose :global(h2:first-child) {
    margin-top: 0;
  }
  .legal-prose :global(p),
  .legal-prose :global(ul),
  .legal-prose :global(dl) {
    margin-top: 1rem;
    color: var(--color-ink-muted);
  }
  .legal-prose :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal-prose :global(li + li) {
    margin-top: 0.4rem;
  }
  .legal-prose :global(dl) {
    display: grid;
    grid-template-columns: minmax(8rem, max-content) 1fr;
    gap: 0.5rem 1.5rem;
  }
  .legal-prose :global(dt) {
    font-weight: 600;
    color: var(--color-ink);
  }
  .legal-prose :global(a) {
    color: var(--color-brand);
    text-decoration: underline;
  }
  .legal-prose :global(strong) {
    color: var(--color-ink);
  }
</style>
